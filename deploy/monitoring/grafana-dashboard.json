      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (bucket, le) (rate(yproxy_s3_request_duration_seconds_bucket{job=~\"$job\",bucket=~\"$bucket\"}[$__rate_interval])))",
          "legendFormat": "{{bucket}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
